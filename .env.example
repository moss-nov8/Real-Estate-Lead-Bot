# =============================================================================
# Real Estate Lead Bot — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# Application
APP_ENV=development
APP_NAME=Real Estate Lead Bot
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-another-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/real_estate_leads
# Or individual components if preferred:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=real_estate_leads

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# n8n
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_WEBHOOK_SECRET=change-me-n8n-secret
N8N_BASE_URL=http://localhost:5678

# AI Provider (example — adjust to your provider)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30

# Google Sheets (optional secondary reporting)
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_CREDENTIALS_PATH=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Notifications (future)
# SLACK_WEBHOOK_URL=
# EMAIL_SMTP_HOST=
# EMAIL_FROM=

# Frontend (Vite / React)
VITE_API_BASE_URL=http://localhost:8000/api/v1
